# Получите НОВЫЙ токен в @BotFather. Никому его не отправляйте.
BOT_TOKEN=

# Telegram ID администраторов через запятую. Узнать свой ID: /id
ADMIN_IDS=

SERVICE_NAME=MOMENTUM SERVICE
SUPPORT_USERNAME=
CURRENCY=KGS

PLATFORMS=MELBET
PLATFORM_MELBET_ICON_CUSTOM_EMOJI_ID=

MIN_DEPOSIT=35
MAX_DEPOSIT=500000
DEPOSIT_FEE_PERCENT=0
PAYMENT_TIMEOUT_SECONDS=300
MIN_WITHDRAW=500
MAX_WITHDRAW=500000

REFERRAL_PERCENT=1
MIN_REFERRAL_WITHDRAW=500

PAYMENT_METHODS=MBANK,BAKAI_BANK
DEPOSIT_INSTRUCTIONS=Переведите точную сумму и отправьте фото или файл чека.

PAYMENT_MBANK_DETAILS=Укажите реквизиты MBANK.
PAYMENT_BAKAI_BANK_DETAILS=Укажите реквизиты BAKAI BANK.

# Банковская HTTPS-ссылка одновременно используется для кнопки и генерации QR.
PAYMENT_MBANK_URL=
PAYMENT_BAKAI_BANK_URL=

# Необязательно: ссылки на приложения банков. Для стандартных пяти банков
# уже заданы официальные ссылки; эти переменные позволяют их переопределить.
PAYMENT_MBANK_ANDROID_URL=
PAYMENT_MBANK_IOS_URL=
PAYMENT_BAKAI_BANK_ANDROID_URL=
PAYMENT_BAKAI_BANK_IOS_URL=

# Общий QR не используется: после выбора банка бот отправляет его отдельным сообщением.
PAYMENT_QR_IMAGE=
PAYMENT_QR_URL_TEMPLATE=

# Публичный HTTPS-адрес Railway для умной кнопки банка. Если указан, бот
# автоматически перенаправит Android в Google Play, iPhone — в App Store.
SMART_LINK_BASE_URL=

# Необязательно: путь к QR-коду, HTTPS URL или Telegram file_id.
# Если изображение не указано, QR автоматически создаётся из PAYMENT_*_URL.
# PAYMENT_MBANK_QR=assets/melbet_mbank_qr.png
# PAYMENT_MEGAPAY_QR=assets/megapay_qr.png
# PAYMENT_BALANCE_QR=assets/balance_qr.png
# PAYMENT_BAKAI_BANK_QR=assets/melbet_bakai_qr.png

# Локально база хранится здесь. В Railway можно удалить DATABASE_PATH:
# при подключённом Volume бот сам сохранит базу в RAILWAY_VOLUME_MOUNT_PATH.
DATABASE_PATH=data/bot.sqlite3

# Bookmaker API. Add real values only in Railway Variables, never in GitHub.
# Проверка игрового ID и валюты в этой версии отключена. Автозачисление
# оставьте выключенным, пока не проведёте тест чека с администратором.
BOOKMAKER_API_AUTO_CREDIT_ENABLED=false

# Optional animated Telegram Custom Emoji IDs. Keep empty to use Unicode fallback.
EMOJI_DEPOSIT_ID=
EMOJI_DEPOSIT_INFO_ID=
EMOJI_WITHDRAW_ID=
EMOJI_INVITE_ID=
EMOJI_SECURITY_ID=
EMOJI_FAST_ID=
EMOJI_WORKING_ID=
EMOJI_OPERATOR_ID=

MELBET_API_BASE_URL=https://partners.servcul.com/CashdeskBotAPI
MELBET_API_HASH=
MELBET_CASHIER_PASSWORD=
MELBET_CASHDESK_ID=
MELBET_LOGIN=
# Не используется: проверка валюты отключена.
MELBET_ALLOWED_CURRENCY_IDS=
